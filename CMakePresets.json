{
  "version": 3,
  "configurePresets": [
    {
      "name": "asan",
      "displayName": "Clang AddressSanitizer",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-optimize-sibling-calls",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fsanitize-address-use-after-scope -fno-omit-frame-pointer -fno-optimize-sibling-calls",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address -shared-libsan",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address -shared-libsan"
      }
    },
    {
      "name": "tsan",
      "displayName": "Clang ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -fno-optimize-sibling-calls",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -fno-optimize-sibling-calls",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread -shared-libsan",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread -shared-libsan"
      }
    }
  ]
}
