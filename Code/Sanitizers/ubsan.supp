# UndefinedBehaviorSanitizer suppressions for external, unbundled libraries.
#
# Keep this file empty until a report has been confirmed to originate in such a
# library. Do not suppress undefined behavior caused by data, alignment, enum
# values, or function pointers supplied by RDKit.
#
# Syntax reference:
#   signed-integer-overflow:function_name_pattern
#   alignment:library_name_pattern

# Downloaded ChemDraw SDK source; not tracked or shipped by RDKit.
signed-integer-overflow:CDXDocument.cpp
implicit-integer-sign-change:CDXIO.h

# Downloaded CoordGen source; not tracked or shipped by RDKit.
signed-integer-overflow:sketcherMinimizer.cpp

# Conda-provided Boost 1.90 integer-range iterator implementation.
implicit-integer-sign-change:irange.hpp
