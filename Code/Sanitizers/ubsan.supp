# UndefinedBehaviorSanitizer suppressions for external, unbundled libraries.
#
# Keep this file empty until a report has been confirmed to originate in such a
# library. Do not suppress undefined behavior caused by data, alignment, enum
# values, or function pointers supplied by RDKit.
#
# Syntax reference:
#   signed-integer-overflow:function_name_pattern
#   alignment:library_name_pattern

# Downloaded ChemDraw SDK source; not tracked or shipped by RDKit.
signed-integer-overflow:*CDXDocument.cpp*
implicit-integer-sign-change:*CDXDocument.cpp*
implicit-signed-integer-truncation,implicit-integer-sign-change:*CDXIO.h*
implicit-signed-integer-truncation:*CDXIO.h*
float-cast-overflow:*CDXIO.h*
implicit-integer-sign-change:*CDXIO.cpp*
implicit-signed-integer-truncation:*CDXObject.cpp*
implicit-integer-sign-change:*CDXUnicode.cpp*
implicit-signed-integer-truncation:*CDXArrow.cpp*
implicit-signed-integer-truncation,implicit-integer-sign-change:*CDXArrow.cpp*

# Downloaded CoordGen source; not tracked or shipped by RDKit.
signed-integer-overflow:*sketcherMinimizer.cpp*

# Conda-provided Boost 1.90 integer-range iterator implementation.
implicit-integer-sign-change:*irange.hpp*
implicit-signed-integer-truncation:*gzip.hpp*
implicit-integer-sign-change:*storage_ptr.hpp*
implicit-integer-sign-change:*vector_indexing_suite.hpp*

# Eigen's SSE absolute-value mask intentionally converts an all-ones unsigned
# constant to a signed packet element.
implicit-integer-sign-change:*PacketMath.h*

# The Conda-provided libstdc++ shared_ptr implementation decrements its
# reference count through a signed-to-unsigned conversion.
implicit-integer-sign-change:*atomicity.h*

# The Conda-provided libstdc++ string_view comparison computes a signed result
# from an unsigned size difference.
implicit-integer-sign-change:*string_view*

# Boost RNG and CRC implementations intentionally discard high bits from
# unsigned shifts.
shift-base:*mersenne_twister.hpp*
shift-base:*crc.hpp*

# Conda libstdc++'s 32-bit mersenne_twister specialization is backed by an
# unsigned-long state array and triggers Clang's local array bounds check.
local-bounds:*random.tcc*
